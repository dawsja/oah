<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The iPhone app's own Info.plist entries; Tauri merges them into the one it generates. -->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>oah</string>
	<!-- The desktop is found (Bonjour) and reached over the local network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>oah finds and connects to the oah app on your computer over your local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_oah._tcp</string>
	</array>
	<!-- Dictation: recorded in the app, transcribed on the phone. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Dictate messages by voice. The audio is turned into text on this iPhone and never leaves it.</string>
	<!-- Attaching a photo, and saving an image from a chat. -->
	<key>NSCameraUsageDescription</key>
	<string>Take a photo to attach to a message.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save images from your chats to Photos.</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
