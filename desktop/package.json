{
  "name": "oah-desktop",
  "private": true,
  "version": "0.1.1",
  "description": "oah desktop app (Tauri 2 + React): the oah engine with a desktop UI",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "bun scripts/engine.ts && tauri build --config src-tauri/tauri.bundle.conf.json",
    "web": "vite",
    "web:bridge": "bun scripts/dev-bridge.ts",
    "vite:build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "icons": "tauri icon ../assets/png/icon/oah-icon-dark-1024.png -o src-tauri/icons",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  }
}
