{
  "name": "oah",
  "private": true,
  "version": "0.3.3",
  "description": "oah — open agent harness: a chat-first desktop app for coding agents",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:debug": "bun ../scripts/dev-debug.ts",
    "web": "vite",
    "web:build": "tsc --noEmit && vite build",
    "mobile:web": "vite --config vite.mobile.config.ts",
    "mobile:build": "tsc --noEmit && vite build --config vite.mobile.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tauri build",
    "android:init": "cd ../android && bun tauri android init",
    "android:dev": "cd ../android && bun tauri android dev",
    "android:build": "cd ../android && bun tauri android build --apk",
    "icons": "tauri icon ../assets/png/icon/oah-icon-dark-1024.png -o src-tauri/icons",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "^4.0.0"
  }
}
