{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oah",
  "mainBinaryName": "oah-desktop",
  "version": "../package.json",
  "identifier": "dev.oah.desktop",
  "build": {
    "beforeDevCommand": "bun run web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "oah",
        "width": 1440,
        "height": 900,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "backgroundColor": "#080808",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: blob: https: http:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "oah — open agent harness",
    "longDescription": "A chat-first desktop app for coding agents: Claude Code and Codex, on this computer or over SSH, with git, worktrees and pull requests built in.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true,
    "resources": [
      "host/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3NkI4Nzg1MUU0RDJEMjIKUldRaUxVMGVoWWRyZDc1TEYyQkVzQVd1YzdCQzUzMUJQNjhtTThiUTZQWHpaM3Nlb1NWNWZsZG8K",
      "endpoints": [
        "https://dl.oah.dev/desktop/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
